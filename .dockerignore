# Only Maven build inputs belong in the context.
**
!pom.xml
!mvnw
!.mvn/
!.mvn/**
!src/
!src/main/
!src/main/**

# Exclude secrets and machine-local files even within allowed directories.
**/.git
**/.git/**
**/.idea/**
**/.vscode/**
**/target/**
**/logs/**
**/*.log
**/*.log.*
**/.env
**/.env.*
**/application-local.*
**/application-*.local.*
**/application-dev.*
**/application-test.*
**/bootstrap-local.*
**/secrets/**
**/key/**
**/keys/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.der
**/settings.xml
**/*.iml
**/*.bak
**/*.tmp
