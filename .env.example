# Runtime environment template; Spring Boot does not automatically load .env files.

# Application identity: optional; default jwks-service (also the JSON log service label).
SPRING_APPLICATION_NAME=jwks-service

# Logging (consumed directly by logback-spring.xml).
# Optional; default ./logs; writable directory. Docker/Compose override to /app/data/logs.
APP_LOG_DIR=./logs
# Optional; default jwks-api; log filename basename, without directories or extension.
APP_NAME=jwks-api
# Optional; default INFO; TRACE, DEBUG, INFO, WARN, ERROR or OFF. Prefer INFO in production.
LOG_LEVEL=INFO
# Optional; dynamically falls back to LOG_LEVEL, then INFO; application logs only.
# LOGGING_LEVEL_COM_JAPANESELEARNING_JWKS=DEBUG
# Optional parent Compose input; default INFO; mapped to the container's LOG_LEVEL.
JWKS_API_LOG_LEVEL=INFO

# Proxy handling: optional; default none; none, native or framework.
# Retain none unless proxy trust is configured; changing this affects logged peer addresses.
SERVER_FORWARD_HEADERS_STRATEGY=none

# Network (Dockerfile ENV; Spring Boot binds server.address / server.port directly).
# Optional; Docker default 0.0.0.0; outside Docker, unset means all local interfaces.
SERVER_ADDRESS=0.0.0.0
# Optional; default 8080; container/application listener port, integer 1-65535 (0 for tests).
SERVER_PORT=8080
# Optional parent Compose input; default 8783; host port mapped to container port 8080.
JWKS_API_HOST_PORT=8783

# Actuator: optional; default health; comma-separated web-exposed endpoint IDs.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# Optional; dynamic default: enabled on Kubernetes, otherwise disabled.
# Parent Compose sets true because its health check uses /actuator/health/readiness.
# MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true

# RSA keys (direct RsaKeyProperties binding; at least one complete entry is required).
# Required; no default; unique, nonblank public key ID, e.g. user-rsa-v1.
APP_SECURITY_JWKS_KEYS_0_KID=
# Required; no default; readable PKCS#8 RSA private-key PEM path inside the runtime.
APP_SECURITY_JWKS_KEYS_0_PRIVATE_KEY_PATH=
# Required; no default; readable X.509 RSA public-key PEM path matching the private key.
APP_SECURITY_JWKS_KEYS_0_PUBLIC_KEY_PATH=
# Optional per entry; default false; boolean. Exactly one configured entry MUST be true.
APP_SECURITY_JWKS_KEYS_0_ACTIVE=false
# Optional additional entries: repeat all four variables with contiguous indices 1, 2, ...
# Each added entry requires its own ID and paths (no defaults); active defaults to false.
# APP_SECURITY_JWKS_KEYS_1_KID=
# APP_SECURITY_JWKS_KEYS_1_PRIVATE_KEY_PATH=
# APP_SECURITY_JWKS_KEYS_1_PUBLIC_KEY_PATH=
# APP_SECURITY_JWKS_KEYS_1_ACTIVE=false
