# Standalone runtime; export before launch (Spring does not load .env automatically).
# Compose uses the root env files instead.

# Listener (Dockerfile defaults)
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
SERVER_FORWARD_HEADERS_STRATEGY=none

# Logging (application defaults; Docker uses /app/data/logs)
SPRING_APPLICATION_NAME=jwks-service
APP_LOG_DIR=./logs
APP_NAME=jwks-api
LOG_LEVEL=INFO

# Optional override; otherwise follows LOG_LEVEL.
# LOGGING_LEVEL_COM_JAPANESELEARNING_JWKS=INFO

# Health (Compose requires readiness probes)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true

# Public RSA keys for a standalone process launched from this submodule.
APP_SECURITY_JWKS_KEYS_0_KID=user-rsa-v1
APP_SECURITY_JWKS_KEYS_0_PUBLICKEYPATH=../key/userservice-public-v1.pem
APP_SECURITY_JWKS_KEYS_0_OWNER=USER
APP_SECURITY_JWKS_KEYS_1_KID=user-rsa-v2
APP_SECURITY_JWKS_KEYS_1_PUBLICKEYPATH=../key/userservice-public-v2.pem
APP_SECURITY_JWKS_KEYS_1_OWNER=USER
APP_SECURITY_JWKS_KEYS_2_KID=learning-rsa-v1
APP_SECURITY_JWKS_KEYS_2_PUBLICKEYPATH=../data/keys/learning/learningservice-public-v1.pem
APP_SECURITY_JWKS_KEYS_2_OWNER=LEARNING

# --- Docker Compose debug settings (root .env only) ---
# Set these in the workspace root .env or shell, not this service env_file.
# They apply only when docker-compose.debug.yml is explicitly included.
# JWKS_API_DEBUG_PORT=5007
# JWKS_API_JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:${JWKS_API_DEBUG_PORT:-5007}
# No DEBUG_ENABLED flag is used; the override file enables debugging.

# --- Phase 0 observability baseline (standalone JVM or service env_file) ---
# Canonical SPRING_APPLICATION_NAME=jwks-service; APP_NAME controls filenames only.
# Existing assignments above remain authoritative. Version defaults to Maven project.version.
# APP_VERSION=0.0.1-SNAPSHOT
# DEPLOYMENT_ENVIRONMENT=development
# MANAGEMENT_METRICS_ENABLE_ALL=true
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# MANAGEMENT_TRACING_ENABLED=true
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
# All remote exporters default to false until a real receiver is configured.
# MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
# MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=false
# MANAGEMENT_LOGGING_EXPORT_OTLP_ENABLED=false
# No OTLP destination, Prometheus registry or tracing bridge is installed by this example.
# Standards: ../observability/README.md in the parent workspace.

# --- Phase 2 private metrics (standalone opt-in; Compose sets these explicitly) ---
# Never publish the scrape listener on a public host interface.
# METRICS_LISTENER_ENABLED=false
# METRICS_LISTENER_PORT=9091
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
# MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
