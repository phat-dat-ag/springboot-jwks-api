# Standalone runtime: export with the launcher/IDE; Spring does not load .env.
# Containers use root .env.jwks-api via Compose, with explicit wiring overrides.

# Application identity and listener
SPRING_APPLICATION_NAME=jwks-service
APP_NAME=jwks-api
APP_VERSION=0.0.1-SNAPSHOT
DEPLOYMENT_ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=default
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=none

# Public RSA keys (required existing X.509 PEM paths; never private keys)
# Contiguous indices; unique IDs; OWNER is USER or LEARNING.
APP_SECURITY_JWKS_KEYS_0_KID=user-rsa-v1
APP_SECURITY_JWKS_KEYS_0_PUBLICKEYPATH=
APP_SECURITY_JWKS_KEYS_0_OWNER=USER
APP_SECURITY_JWKS_KEYS_1_KID=user-rsa-v2
APP_SECURITY_JWKS_KEYS_1_PUBLICKEYPATH=
APP_SECURITY_JWKS_KEYS_1_OWNER=USER
APP_SECURITY_JWKS_KEYS_2_KID=learning-rsa-v1
APP_SECURITY_JWKS_KEYS_2_PUBLICKEYPATH=
APP_SECURITY_JWKS_KEYS_2_OWNER=LEARNING

# Logging and bounded spool retention
# Set both root/category levels when changing the standalone application level.
LOG_LEVEL=INFO
LOGGING_LEVEL_COM_JAPANESELEARNING_JWKS=INFO
APP_LOG_DIR=./logs
APP_LOG_MAX_FILE_SIZE=100MB
APP_LOG_MAX_HISTORY=30
APP_LOG_TOTAL_SIZE_CAP=2GB

# Health and private metrics (no host publication of the metrics listener)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_METRICS_ENABLE_ALL=true
METRICS_LISTENER_ENABLED=false
METRICS_LISTENER_PORT=9091
APP_METRICS_LISTENER_ADDRESS=0.0.0.0
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# Tracing and remote exporters (off until receivers/access budgets are configured)
# APP_VERSION documents the artifact version; unset in the launcher to use Maven filtering.
MANAGEMENT_TRACING_ENABLED=true
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=false
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
MANAGEMENT_LOGGING_EXPORT_OTLP_ENABLED=false
